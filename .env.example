# Copy to .env and adjust for your machine
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.88.241, 192.168.88.23

# Comma-separated origins (Expo dev server, web, physical device via LAN IP)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.88.23:8081,http://localhost:19006,http://127.0.0.1:19006

# Database: sqlite (default) or postgresql for study deployment
DB_ENGINE=sqlite
# DB_ENGINE=postgresql
# DB_NAME=wunally
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# OpenAI (server-side only — never expose in mobile app)
OPENAI_API_KEY= 
OPENAI_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=500
